# Configuración global para Docker Compose
# Renombra este archivo a .env y cambia las contraseñas en producción

# ================================
# Base de Datos (MySQL)
# ================================
DB_DATABASE=nemon_energy
DB_USERNAME=root
DB_PASSWORD=root_password_segura

# ================================
# Backend (Laravel)
# ================================
APP_NAME=NemonEnergy
APP_ENV=production
APP_DEBUG=false
APP_URL=https://nemon.robbytherobot.tech
